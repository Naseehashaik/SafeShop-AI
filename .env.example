# Copy this file to `.env` and fill in values.
# Never commit `.env` — it can contain secrets.

# SQLite file used by Prisma (local development)
DATABASE_URL="file:./dev.db"

# LLM — add one of these in a later step (do not put real secrets in git)
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Razorpay Test Mode only — never use live keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_MODE="test"
