generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Step 0: prove the database is wired.
// Full catalog, wallet, orders, and audit models come in later steps.
model SetupCheck {
  id        Int      @id @default(autoincrement())
  label     String
  createdAt DateTime @default(now())
}
